# syntax=docker/dockerfile:1.7
###############################################################################
# Dockerfile.agents — middle layer of the NeoLabHQ sandbox image chain.
#
# Chain: base -> agents -> final.
#   - Inherits everything from Dockerfile.base (mise, Homebrew, dvc/yq, codespace
#     user, /usr/local/share/mise/shims already on PATH).
#   - Adds AI coding agents + their code-intelligence dependencies + the
#     docker-mcp CLI plugin (migrated from .devcontainer/devcontainer.json's
#     `bash-command` feature).
#
# Rationale, layering decisions, and the full migration table live in:
#   .specs/tasks/todo/setup-docker-image.chore.md
#   (sections "AI Coding Agents", "MCP Servers", and "Step 2: Create
#   Dockerfile.agents").
#
# Architectural note: codemap, gopls, pyright, jdtls, and typescript-language-
# server are installed HERE (not in the final Dockerfile) because they are
# code-intelligence dependencies of the AI agents themselves — codemap feeds
# agent context; the LSPs are backends the agents call via MCP. Installing
# them at the agents layer keeps that layer self-sufficient for any consumer
# and avoids re-installing heavy Go/npm toolchains in the final image. The
# final Dockerfile (Step 4) only verifies their presence; it does NOT
# re-install them.
#
# This layer does NOT install configure-claude.sh / statusline.sh /
# install-mcps.sh — those are owned by the final Dockerfile (Step 4).
###############################################################################

ARG BASE_IMAGE=ghcr.io/neolabhq/sandbox:base
FROM ${BASE_IMAGE}

###############################################################################
# Force every `RUN` to use bash with `-o pipefail` so that piped installers
# (e.g. `curl -fsSL https://… | bash` for Claude Code and OpenCode) abort
# loudly if curl returns a partial body, a 404, or a redirect to nowhere.
# Docker's default `/bin/sh` is dash on Debian/Ubuntu and silently treats a
# broken upstream pipe as success — producing a layer that builds clean but
# contains no installed binary. See .claude/rules/dockerfile-curl-pipe-pipefail.md.
###############################################################################
SHELL ["/bin/bash", "-o", "pipefail", "-c"]

###############################################################################
# OCI image annotations. Consumers (GHCR UI, `docker inspect`, Renovate,
# Dependabot, supply-chain scanners) read these labels to surface source,
# description, and license. Declared once at the top of the file so they
# stick to the final image even if intermediate layers shuffle around.
###############################################################################
LABEL org.opencontainers.image.source="https://github.com/NeoLabHQ/sandbox"
LABEL org.opencontainers.image.description="NeoLabHQ sandbox: AI coding agents (Claude, OpenCode, Gemini, Codex) + LSPs (gopls, pyright, jdtls, typescript-language-server) + codemap + docker-mcp on top of :base"
LABEL org.opencontainers.image.licenses="MIT"

###############################################################################
# PATH layout for the agents layer.
#
# Why set PATH this early, before any RUN?
#   - The Claude Code installer drops binaries into ~/.local/bin (codespace).
#   - npm globals land in the user-writable prefix configured below
#     (/home/codespace/.npm-global) so installs work without sudo.
#   - `go install` puts binaries in $GOBIN — we set it to ~/.local/bin so
#     go-installed code-intelligence binaries (gopls, and anything else added
#     later via `go install`) land on PATH for the codespace user with no
#     extra wiring. Note: codemap is NOT installed via `go install`; it is
#     built from a git clone and copied to /usr/local/bin/codemap (system
#     bin, already on the inherited PATH) so it is available to every user.
#   - docker-mcp lives in the CLI-plugins dir; Docker CLI discovers it via
#     ~/.docker/cli-plugins/, but having the dir on PATH lets users invoke
#     the binary directly too.
#
# Inherited from Dockerfile.base:
#   - /usr/local/share/mise/shims (so `node`, `python`, `go`, `java` resolve
#     via mise).
###############################################################################
ENV NPM_CONFIG_PREFIX=/home/codespace/.npm-global \
    GOBIN=/home/codespace/.local/bin \
    PATH=/home/codespace/.local/bin:/home/codespace/.npm-global/bin:/home/codespace/.docker/cli-plugins:${PATH}

###############################################################################
# Prepare user-writable directories as root so chown is consistent.
###############################################################################
USER root

RUN mkdir -p \
        /home/codespace/.local/bin \
        /home/codespace/.npm-global \
        /home/codespace/.docker/cli-plugins \
 && chown -R codespace:codespace \
        /home/codespace/.local \
        /home/codespace/.npm-global \
        /home/codespace/.docker

###############################################################################
# Build-time apt deps used only for installs in this layer.
#
# - `make` is needed to build docker-mcp from source.
# - everything else (curl, git, ca-certificates, tar, gzip, build-essential,
#   go, node, npm, java) is already provided by the base image.
###############################################################################
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    apt-get update \
 && apt-get install -y --no-install-recommends \
        make \
 && apt-get clean \
 && rm -rf /var/lib/apt/lists/*

###############################################################################
# AI coding agents (installed as codespace).
#
# - Claude Code: official curl installer (the legacy
#   `npm install -g @anthropic-ai/claude-code` is deprecated). Installs to
#   ~/.local/bin/claude.
# - OpenCode: official curl installer. Installs to ~/.opencode/bin (the
#   installer prints the exact path); we symlink the binary into
#   ~/.local/bin so a single PATH entry covers all four agents.
# - Gemini CLI: npm global. Requires Node 20+ (satisfied by mise's node@lts).
# - Codex CLI: npm global.
###############################################################################
USER codespace

RUN curl -fsSL https://claude.ai/install.sh | bash

RUN curl -fsSL https://opencode.ai/install | bash \
 && if [ -x /home/codespace/.opencode/bin/opencode ]; then \
        ln -sf /home/codespace/.opencode/bin/opencode /home/codespace/.local/bin/opencode; \
    fi

###############################################################################
# npm globals.
#
# NPM_CONFIG_PREFIX (set via ENV above) routes `npm install -g` into
# /home/codespace/.npm-global so codespace can install globals without sudo.
# `npm config set prefix` would only persist to ~/.npmrc; the env var is
# strictly more reliable for non-interactive shells.
#
# Bundled here:
#   - @google/gemini-cli, @openai/codex — required AI agents.
#   - typescript-language-server, typescript — TypeScript LSP (used by agents
#     via MCP / editor integrations).
#   - pyright — Python LSP.
#   - rust-just, bun — general-purpose CLI tools preserved from the legacy
#     .devcontainer/Dockerfile (rust-just is the `just` task runner; bun
#     is an alternative JS runtime / package manager).
###############################################################################
RUN npm install -g \
        @google/gemini-cli \
        @openai/codex \
        typescript-language-server \
        typescript \
        pyright \
        rust-just \
        bun \
 && npm cache clean --force

###############################################################################
# codemap — Go binary that feeds project structure context to AI agents.
#
# Built as the codespace user using the mise-managed Go from the base image
# (the `go` shim at /usr/local/share/mise/shims/go resolves to the active
# Go toolchain, whose state lives under /usr/local/share/mise — owned by
# codespace per the base image). Building as root risks mise refusing to
# operate when the data dir is owned by a different user, so we build under
# codespace and use sudo only to install the binary system-wide into
# /usr/local/bin (matches the legacy .devcontainer/Dockerfile layout and
# keeps codemap on PATH for every user).
#
# The /tmp/codemap clone is removed inside the same RUN to keep the layer
# small.
###############################################################################
RUN git clone --depth 1 https://github.com/JordanCoin/codemap.git /tmp/codemap \
 && cd /tmp/codemap \
 && go build -o /tmp/codemap/codemap . \
 && sudo install -m 0755 /tmp/codemap/codemap /usr/local/bin/codemap \
 && rm -rf /tmp/codemap /home/codespace/go/pkg /home/codespace/.cache/go-build

###############################################################################
# gopls — Go language server.
#
# Installed via `go install` as codespace; GOBIN (set via ENV above) routes
# the resulting binary into /home/codespace/.local/bin so it is on PATH for
# the codespace user without any extra wiring. Using `go install` (rather
# than apt or brew) is the upstream-recommended install for gopls.
###############################################################################
USER codespace

RUN go install golang.org/x/tools/gopls@latest \
 && rm -rf /home/codespace/go/pkg /home/codespace/.cache/go-build

###############################################################################
# jdtls — Eclipse JDT language server for Java.
#
# Strategy:
#   1. Discover the latest milestone version by scraping the milestones
#      directory listing (https://download.eclipse.org/jdtls/milestones/).
#      Directory names are pure semver (e.g. `1.58.0`); sort -V picks the
#      newest.
#   2. Discover the actual tarball name inside that version directory
#      (`jdt-language-server-<version>-<timestamp>.tar.gz`) the same way.
#   3. Download + extract into /opt/jdtls.
#   4. Symlink the launcher (`bin/jdtls` inside the tarball) onto
#      /usr/local/bin/jdtls so it is on PATH for every user.
#
# We use the milestones channel (not snapshots) per the task spec — milestones
# are intentional releases; snapshots are unstable CI artifacts.
#
# Java itself comes from the base image's mise-managed Temurin LTS (the
# `java` shim at /usr/local/share/mise/shims/java resolves correctly).
###############################################################################
USER root

RUN set -eux; \
    base_url="https://download.eclipse.org/jdtls/milestones"; \
    version="$( \
        curl -fsSL "${base_url}/?d" \
        | grep -oE "href='/jdtls/milestones/[0-9]+\.[0-9]+(\.[0-9]+)?'" \
        | grep -oE '[0-9]+\.[0-9]+(\.[0-9]+)?' \
        | sort -V \
        | tail -n 1 \
    )"; \
    [ -n "${version}" ] || { echo "Failed to resolve latest jdtls milestone version"; exit 1; }; \
    tarball="$( \
        curl -fsSL "${base_url}/${version}/?d" \
        | grep -oE "jdt-language-server-${version}-[0-9]+\.tar\.gz" \
        | sort -u \
        | tail -n 1 \
    )"; \
    [ -n "${tarball}" ] || { echo "Failed to resolve jdtls tarball for ${version}"; exit 1; }; \
    echo "Installing jdtls ${version} (${tarball})"; \
    mkdir -p /opt/jdtls; \
    curl -fsSL "${base_url}/${version}/${tarball}" \
        | tar -xz -C /opt/jdtls; \
    ln -sf /opt/jdtls/bin/jdtls /usr/local/bin/jdtls; \
    chmod +x /opt/jdtls/bin/jdtls

###############################################################################
# docker-mcp CLI plugin — migrated from the legacy
# .devcontainer/devcontainer.json `bash-command` feature.
#
# Baking this into the image (instead of running it as a devcontainer feature)
# shaves ~30-60s off every devcontainer start, makes the plugin available to
# plain `docker run` consumers, and eliminates the brittle bash-command
# feature wrapper. Only the Docker CLI is needed at runtime, which is supplied
# by the host's docker socket via the preserved `docker-outside-of-docker`
# devcontainer feature.
#
# Built as codespace (matching the legacy bash-command pattern) so that:
#   1. The mise-managed `go` toolchain (whose data dir is owned by codespace
#      under /usr/local/share/mise) runs as its owner — avoids mise refusing
#      to operate when the data dir is owned by a different user.
#   2. The Makefile's default `DOCKER_MCP_CLI_PLUGIN_DST=$HOME/.docker/
#      cli-plugins/docker-mcp` lands the binary in the right place with the
#      right ownership in one step — no chown follow-up needed.
#
# The /tmp/mcp-gateway scratch dir is cloned as codespace (so subsequent rm
# does not need sudo) and removed at the end of the same RUN to keep the
# layer small.
###############################################################################
USER codespace

RUN set -eux; \
    git clone --depth 1 https://github.com/docker/mcp-gateway.git /tmp/mcp-gateway; \
    cd /tmp/mcp-gateway; \
    HOME=/home/codespace make docker-mcp; \
    rm -rf /tmp/mcp-gateway /home/codespace/go/pkg /home/codespace/.cache/go-build

###############################################################################
# Belt-and-braces ownership fix for ~/.docker.
#
# The Makefile above lands the plugin in $HOME/.docker/cli-plugins/docker-mcp
# while running as codespace, so ownership is *already* correct in practice
# (and the pre-chown at the top of this file pre-creates the dir). We still
# perform an explicit `chown -R codespace:codespace /home/codespace/.docker`
# here because:
#   1. The task spec (Step 2) literally requires it as the documented
#      ownership guarantee for this layer — downstream consumers should not
#      have to inspect the Makefile to know who owns ~/.docker.
#   2. If `make docker-mcp` ever changes to emit files under a sub-path with
#      different ownership (e.g. a vendored cache), this catches it.
###############################################################################
USER root
RUN chown -R codespace:codespace /home/codespace/.docker

###############################################################################
# Final user. The agents image must hand off to downstream consumers (the
# final Dockerfile, devcontainer, plain `docker run`) as the non-root
# codespace user — matching the base image's contract.
###############################################################################
USER codespace
